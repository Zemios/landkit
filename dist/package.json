{
  "name": "@zemios/landkit",
  "version": "0.4.0",
  "description": "Zemios design system — Angular building blocks, design tokens and brand primitives shared by every Zemios product (Atlas, Edubot, Cronos, Nebula, even2me…).",
  "type": "module",
  "main": "./dist/fesm2022/zemios-landkit.mjs",
  "module": "fesm2022/zemios-landkit.mjs",
  "files": [
    "dist",
    "README.md",
    "STYLE_GUIDE.md"
  ],
  "private": false,
  "sideEffects": false,
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lottiefiles/dotlottie-wc": "^0.9.2",
    "@ngx-translate/core": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@lottiefiles/dotlottie-wc": {
      "optional": true
    }
  },
  "keywords": [
    "zemios",
    "design-system",
    "design-tokens",
    "angular",
    "ui",
    "components",
    "bootstrap",
    "tailwind",
    "atlas",
    "edubot",
    "cronos",
    "nebula"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "typings": "types/zemios-landkit.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/zemios-landkit.d.ts",
      "default": "./fesm2022/zemios-landkit.mjs"
    }
  }
}