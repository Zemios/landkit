{
  "name": "@zemios/landkit",
  "version": "0.2.1",
  "description": "Zemios design system — Angular building blocks, design tokens and brand primitives shared by every Zemios product (Atlas, Edubot, Cronos, Nebula, even2me…).",
  "type": "module",
  "main": "./src/public-api.ts",
  "module": "./src/public-api.ts",
  "exports": {
    ".": {
      "types": "./src/public-api.ts",
      "default": "./src/public-api.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tokens.css": "./src/tokens/zemios.css",
    "./package.json": "./package.json",
    "./README.md": "./README.md",
    "./STYLE_GUIDE.md": "./STYLE_GUIDE.md"
  },
  "files": ["src", "tsconfig.json", "README.md", "STYLE_GUIDE.md"],
  "private": false,
  "sideEffects": false,
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "demo": "npx http-server . -p 4321 -c-1 --cors -o /demo/index.html"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lottiefiles/dotlottie-wc": "^0.9.2",
    "@ngx-translate/core": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@lottiefiles/dotlottie-wc": {
      "optional": true
    }
  },
  "keywords": [
    "zemios",
    "design-system",
    "design-tokens",
    "angular",
    "ui",
    "components",
    "bootstrap",
    "tailwind",
    "atlas",
    "edubot",
    "cronos",
    "nebula"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  }
}