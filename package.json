{
  "name": "@zemios/landkit",
  "version": "0.4.1",
  "description": "Zemios design system — Angular building blocks, design tokens and brand primitives shared by every Zemios product (Atlas, Edubot, Cronos, Nebula, even2me…).",
  "type": "module",
  "main": "./dist/fesm2022/zemios-landkit.mjs",
  "module": "./dist/fesm2022/zemios-landkit.mjs",
  "types": "./dist/types/zemios-landkit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/zemios-landkit.d.ts",
      "default": "./dist/fesm2022/zemios-landkit.mjs"
    },
    "./package.json": "./package.json",
    "./README.md": "./README.md",
    "./STYLE_GUIDE.md": "./STYLE_GUIDE.md"
  },
  "files": ["dist", "README.md", "STYLE_GUIDE.md"],
  "private": false,
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "demo": "npx http-server . -p 4321 -c-1 --cors -o /demo/index.html"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lottiefiles/dotlottie-wc": "^0.9.2",
    "@ngx-translate/core": "^17.0.0",
    "ng-packagr": "^21.0.0",
    "typescript": "~5.9.0"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lottiefiles/dotlottie-wc": "^0.9.2",
    "@ngx-translate/core": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@lottiefiles/dotlottie-wc": {
      "optional": true
    }
  },
  "keywords": [
    "zemios",
    "design-system",
    "design-tokens",
    "angular",
    "ui",
    "components",
    "bootstrap",
    "tailwind",
    "atlas",
    "edubot",
    "cronos",
    "nebula"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  }
}